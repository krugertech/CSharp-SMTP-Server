<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted so the DKIM suite can run. MimeKit 4.17 ships net8.0 and net10.0 builds;
         a net7.0 consumer falls back to its netstandard2.1 build, whose Ed25519DigestSigner is
         incompatible with the BouncyCastle 2.6.2 that MimeKit itself requires, so any DkimSigner
         use throws TypeLoadException. net7.0 is retained because it is the framework the shipped
         library targets and the rest of the suite must keep proving it works there. -->
    <TargetFrameworks>net7.0;net8.0</TargetFrameworks>
    <RootNamespace>CSharp_SMTP_Server.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- C# 12 for collection expressions in the DNS stub / test helpers (test project only). -->
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="3.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.7.1" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharp-SMTP-Server\CSharp-SMTP-Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Integration tests bind loopback ports; run test classes serially to avoid port-allocation races. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
