<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Platforms>AnyCPU</Platforms>

    <DebugSymbols>true</DebugSymbols>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <PackageId>Krugertech.CSharp-SMTP-Server</PackageId>
    <RootNamespace>CSharp_SMTP_Server</RootNamespace>
    <Authors>Łukasz Jurczyk, Llewellyn Kruger</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Copyright>Copyright by Łukasz Jurczyk, 2019-2023, Llewellyn Kruger 2026</Copyright>
    <PackageProjectUrl>https://github.com/krugertech/CSharp-SMTP-Server</PackageProjectUrl>
    <RepositoryUrl>https://github.com/krugertech/CSharp-SMTP-Server</RepositoryUrl>
    <RepositoryType>GIT</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <SignAssembly>false</SignAssembly>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <LangVersion>11</LangVersion>
    <Nullable>enable</Nullable>
    <PackageVersion>2.0.0-krugertech.1</PackageVersion>
    <Title>Krugertech CSharp SMTP Server</Title>
    <Description>
      Krugertech fork of CSharp-SMTP-Server v1.1.6 with ACK-gated DATA delivery support.
    </Description>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <PackageTags>smtp;smtp-server;spf</PackageTags>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile>bin\Release\CSharp-SMTP-Server.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DocumentationFile>bin\Debug\CSharp-SMTP-Server.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="True" PackagePath="\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
  </ItemGroup>

  <!-- Expose internal helpers (ProcessAddress, Base64, ClientProcessor.WriteCode, ...) to the test project.
       The test assembly is unsigned, so no public key is required. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CSharp-SMTP-Server.Tests" />
  </ItemGroup>
</Project>
